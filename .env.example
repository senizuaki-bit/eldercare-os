# Local development defaults only. Never reuse these values in production.
NODE_ENV=development
ELDERCARE_ALLOW_DEMO_SEED=true
APP_VERSION=0.0.1
LOG_LEVEL=info

ADMIN_WEB_PORT=3000
MOBILE_WEB_PORT=3001
API_PORT=4000
WORKER_PORT=4001
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:3000,http://localhost:3001

DATABASE_URL=postgresql://eldercare:eldercare_dev_only@localhost:5432/eldercare
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=eldercare_dev
MINIO_SECRET_KEY=eldercare_dev_only
MINIO_BUCKET=eldercare-private
# Presigned voice POSTs expire after 5 minutes; orphan sweep waits 15 minutes from object completion.
VOICE_UPLOAD_AUTHORIZATION_TTL_SECONDS=300
VOICE_STAGING_SWEEP_MIN_AGE_SECONDS=900

MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=eldercare-local
MQTT_EMERGENCY_CLIENT_ID=eldercare-m04-worker-emergency-v1

# Non-clinical emergency runtime settings. SLA thresholds are versioned
# facility policies in PostgreSQL, not process-wide environment switches.
EMERGENCY_LOCATION_RETENTION_HOURS=24
EMERGENCY_DUPLICATE_WINDOW_SECONDS=30
EMERGENCY_FALLBACK_PHONE=400-000-0120
EMERGENCY_QUEUE_PREFIX=eldercare:emergency

READINESS_TIMEOUT_MS=1500

# Local authentication policy. Cookies hold only opaque random session values.
AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=28800
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_KEY_PREFIX=eldercare:auth

# Fictional local seed credential only. The seed command refuses production mode.
M01_DEMO_PASSWORD=LocalDemoOnly!2026
