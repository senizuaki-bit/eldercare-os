# Local development defaults only. Never reuse these values in production.
NODE_ENV=development
APP_VERSION=0.0.1
LOG_LEVEL=info

ADMIN_WEB_PORT=3000
MOBILE_WEB_PORT=3001
API_PORT=4000
WORKER_PORT=4001
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:3000,http://localhost:3001

DATABASE_URL=postgresql://eldercare:eldercare_dev_only@localhost:5432/eldercare
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=eldercare_dev
MINIO_SECRET_KEY=eldercare_dev_only
MINIO_BUCKET=eldercare-private

MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=eldercare-local

READINESS_TIMEOUT_MS=1500
