{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "APP_VERSION",
    "DATABASE_URL",
    "REDIS_URL",
    "MQTT_URL",
    "NEXT_PUBLIC_API_BASE_URL"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "db:generate": {
      "outputs": ["src/generated/prisma/**"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "@eldercare/db#build": {
      "dependsOn": ["db:generate", "^build"],
      "outputs": ["dist/**"]
    },
    "@eldercare/db#lint": {
      "dependsOn": ["db:generate", "^build", "^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "@eldercare/db#typecheck": {
      "dependsOn": ["db:generate", "^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
