{
  "name": "@eldercare/iot-simulator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=development watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "check": "tsx --conditions=development src/main.ts --check",
    "dry-run": "tsx --conditions=development src/main.ts --dry-run",
    "lint": "eslint src test vitest.config.ts vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@eldercare/config": "workspace:*",
    "@eldercare/contracts": "workspace:*",
    "@eldercare/observability": "workspace:*",
    "mqtt": "5.15.2"
  },
  "devDependencies": {
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
