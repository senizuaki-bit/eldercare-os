{
  "name": "@eldercare/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "prisma"],
  "scripts": {
    "build": "prisma generate --config prisma.config.ts && tsc -p tsconfig.build.json",
    "lint": "eslint src prisma.config.ts prisma/seed.ts --ignore-pattern generated",
    "typecheck": "prisma generate --config prisma.config.ts && tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests src",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:seed": "pnpm --filter @eldercare/authz build && prisma db seed --config prisma.config.ts",
    "db:reset": "prisma migrate reset --force --config prisma.config.ts"
  },
  "dependencies": {
    "@eldercare/authz": "workspace:*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "prisma": "7.8.0",
    "tsx": "4.23.0"
  }
}
