generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum FacilityStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum DataScopeKind {
  PLATFORM
  ORGANIZATION
  FACILITY
  FLOOR
  CARE_TEAM
  ASSIGNED_ELDER
  ACTIVE_SHIFT
  LINKED_ELDER
  OWN_RECORD
}

enum AuditActorType {
  USER
  ANONYMOUS
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model SystemMetadata {
  key       String   @id @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("_system_metadata")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  slug      String             @unique @db.VarChar(64)
  name      String             @db.VarChar(160)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  facilities   Facility[]
  userRoles    UserRole[]
  authSessions AuthSession[]
  auditEvents  AuditEvent[]

  @@index([status])
  @@map("organizations")
}

model Facility {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  code           String         @db.VarChar(64)
  name           String         @db.VarChar(160)
  timezone       String         @default("Asia/Shanghai") @db.VarChar(64)
  status         FacilityStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataScopes   DataScope[]
  authSessions AuthSession[]
  auditEvents  AuditEvent[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("facilities")
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  loginName           String     @map("login_name") @db.VarChar(96)
  normalizedLoginName String     @unique @map("normalized_login_name") @db.VarChar(96)
  displayName         String     @map("display_name") @db.VarChar(128)
  status              UserStatus @default(ACTIVE)
  sessionVersion      Int        @default(1) @map("session_version")
  accessVersion       Int        @default(1) @map("access_version")
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordCredential PasswordCredential?
  userRoles          UserRole[]          @relation("AssignedUser")
  createdAssignments UserRole[]          @relation("UserRoleCreatedBy")
  revokedAssignments UserRole[]          @relation("UserRoleRevokedBy")
  sessions           AuthSession[]
  auditEvents        AuditEvent[]

  @@index([status])
  @@map("users")
}

model PasswordCredential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(512)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]
  userAssignments UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(128)
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  activeFrom      DateTime  @default(now()) @map("active_from") @db.Timestamptz(3)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation("AssignedUser", fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("UserRoleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy    User?        @relation("UserRoleRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  dataScopes   DataScope[]

  @@unique([id, organizationId])
  @@index([userId, organizationId, revokedAt, expiresAt])
  @@index([organizationId, roleId, revokedAt])
  @@map("user_roles")
}

model DataScope {
  id             String        @id @default(uuid()) @db.Uuid
  userRoleId     String        @map("user_role_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  kind           DataScopeKind
  scopeKey       String        @map("scope_key") @db.VarChar(192)
  facilityId     String?       @map("facility_id") @db.Uuid
  resourceType   String?       @map("resource_type") @db.VarChar(64)
  resourceId     String?       @map("resource_id") @db.VarChar(128)
  validFrom      DateTime      @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil     DateTime?     @map("valid_until") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  userRole UserRole  @relation(fields: [userRoleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([userRoleId, scopeKey])
  @@index([organizationId, kind, facilityId])
  @@index([resourceType, resourceId])
  @@map("data_scopes")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  facilityId        String?   @map("facility_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash     String    @map("csrf_token_hash") @db.Char(64)
  sessionVersion    Int       @map("session_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(96)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility     Facility?    @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([userId, revokedAt, absoluteExpiresAt])
  @@index([organizationId, revokedAt, idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  facilityId     String?        @map("facility_id") @db.Uuid
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  action         String         @db.VarChar(128)
  outcome        AuditOutcome
  resourceType   String?        @map("resource_type") @db.VarChar(64)
  resourceId     String?        @map("resource_id") @db.VarChar(128)
  reasonCode     String?        @map("reason_code") @db.VarChar(96)
  correlationId  String         @map("correlation_id") @db.VarChar(128)
  safeMetadata   Json           @default("{}") @map("safe_metadata")
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility     Facility?    @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([correlationId])
  @@map("audit_events")
}
