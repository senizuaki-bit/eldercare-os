  idempotencyKey   String            @map("idempotency_key") @db.VarChar(192)
  occurredAt       DateTime          @map("occurred_at") @db.Timestamptz(3)
  payload          Json
  privacyClass     EventPrivacyClass @map("privacy_class")
  status           OutboxStatus      @default(PENDING)
  attempts         Int               @default(0)
  availableAt      DateTime          @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  lastErrorCode    String?           @map("last_error_code") @db.VarChar(96)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility     Facility?    @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, eventType, idempotencyKey])
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, aggregateVersion])
  @@index([correlationId])
  @@map("outbox_events")
}
