/// Append-only receipts for M04 commands that are audited but deliberately do
/// not publish a business event (for example responder assignment and a family
/// member's notification preference update).
model EmergencyCommandReceipt {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  facilityId         String   @map("facility_id") @db.Uuid
  actorUserId        String   @map("actor_user_id") @db.Uuid
  commandKind        String   @map("command_kind") @db.VarChar(64)
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  resourceType       String   @map("resource_type") @db.VarChar(64)
  resourceId         String   @map("resource_id") @db.VarChar(128)
  resultVersion      Int      @map("result_version")
  correlationId      String   @map("correlation_id") @db.VarChar(128)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility     Facility     @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor        User         @relation("EmergencyCommandReceiptActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, actorUserId, commandKind, idempotencyKey], map: "emergency_command_receipts_organization_id_actor_user_id_c_key")
  @@unique([id, organizationId, facilityId], map: "emergency_command_receipts_id_organization_id_facility_key")
  @@index([organizationId, facilityId, resourceType, resourceId], map: "emergency_command_receipts_organization_id_facility_id_res_idx")
  @@index([correlationId], map: "emergency_command_receipts_correlation_id_idx")
  @@map("emergency_command_receipts")
}

model OutboxEvent {
  eventId          String            @id @map("event_id") @db.VarChar(26)
  eventType        String            @map("event_type") @db.VarChar(128)
  schemaVersion    String            @map("schema_version") @db.VarChar(16)
  organizationId   String            @map("organization_id") @db.Uuid
  facilityId       String?           @map("facility_id") @db.Uuid
  aggregateType    String            @map("aggregate_type") @db.VarChar(64)
  aggregateId      String            @map("aggregate_id") @db.VarChar(128)
  aggregateVersion Int               @map("aggregate_version")
  actorType        EventActorType    @map("actor_type")
  actorId          String            @map("actor_id") @db.VarChar(128)
  correlationId    String            @map("correlation_id") @db.VarChar(128)
  causationId      String?           @map("causation_id") @db.VarChar(26)
  idempotencyKey   String            @map("idempotency_key") @db.VarChar(192)
  occurredAt       DateTime          @map("occurred_at") @db.Timestamptz(3)
  payload          Json
  privacyClass     EventPrivacyClass @map("privacy_class")
  status           OutboxStatus      @default(PENDING)
  attempts         Int               @default(0)
  availableAt      DateTime          @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  lastErrorCode    String?           @map("last_error_code") @db.VarChar(96)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility     Facility?    @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, eventType, idempotencyKey])
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, aggregateVersion])
  @@index([correlationId])
  @@map("outbox_events")
}
