generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum FacilityStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum DataScopeKind {
  PLATFORM
  ORGANIZATION
  FACILITY
  FLOOR
  CARE_TEAM
  ASSIGNED_ELDER
  ACTIVE_SHIFT
  LINKED_ELDER
  OWN_RECORD
}

enum AuditActorType {
  USER
  ANONYMOUS
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum FacilityStructureStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BedOperationalStatus {
  ACTIVE
  OUT_OF_SERVICE
  ARCHIVED
}

enum ElderRecordStatus {
  ACTIVE
  DISCHARGED
  ARCHIVED
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  CANCELLED
}

enum ElderStayStatus {
  PLANNED
  ACTIVE
  DISCHARGED
  CANCELLED
}

enum CareLevelStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FamilyRelationshipType {
  SPOUSE
  CHILD
  SIBLING
  GUARDIAN
  OTHER
}

enum RelationshipVerificationStatus {
  PENDING
  VERIFIED
  REVOKED
}

enum BaselineSource {
  ELDER_STATED
  STAFF_CONFIRMED
  INFERRED
}

enum PersonalBaselineDomain {
  ROUTINE
  COMMUNICATION
  MOBILITY
  SOCIAL
  SLEEP
  DIET
  EMOTIONAL_EXPRESSION
  OTHER
}

enum ConsentPurpose {
  VOICE_CAPTURE
  TRANSCRIPTION_AI_ANALYSIS
  EMOTION_TREND
  ELDER_LOCATION
  CAREGIVER_SHIFT_LOCATION
  FAMILY_SHARING
  AI_MEMORY
  CONTENT_PERSONALIZATION
  COMMERCIAL_RECOMMENDATION
  FAMILY_PAYMENT
  PRODUCT_IMPROVEMENT_TRAINING
}

enum ConsentDecision {
  GRANTED
  DECLINED
  WITHDRAWN
}

enum ConsentAuthority {
  ELDER
  AUTHORIZED_REPRESENTATIVE
  LEGAL_BASIS
}

enum PreferredTextScale {
  STANDARD
  LARGE
  EXTRA_LARGE
}

enum PreferredInputMode {
  TOUCH
  VOICE
  HUMAN_ASSISTED
}

enum SpeakingPace {
  SLOW
  STANDARD
}

enum CommunicationChannel {
  VOICE
  TEXT
  IN_PERSON
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TeamMembershipRole {
  MEMBER
  LEAD
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ShiftAssignmentStatus {
  ASSIGNED
  ACCEPTED
  CANCELLED
}

enum ShiftScopeKind {
  FACILITY
  FLOOR
  ZONE
}

enum ElderCareAssignmentRole {
  PRIMARY
  SUPPORT
}

enum TimelineVisibility {
  INTERNAL
  ELDER_VISIBLE
  FAMILY_ELIGIBLE
}

enum FamilyShareableField {
  PREFERRED_NAME
  CURRENT_RESIDENCE
  CARE_LEVEL
  ACCESSIBILITY_SUMMARY
  COMMUNICATION_PREFERENCE
  PERSONAL_BASELINE_SUMMARY
  CONSENT_SUMMARY
  TIMELINE_SUMMARY
}

enum EventActorType {
  USER
  SYSTEM
  DEVICE
  AGENT
}

enum EventPrivacyClass {
  OPERATIONS
  SENSITIVE
  HIGHLY_SENSITIVE
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model SystemMetadata {
  key       String   @id @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("_system_metadata")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  slug      String             @unique @db.VarChar(64)
  name      String             @db.VarChar(160)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  facilities   Facility[]
  userRoles    UserRole[]
  authSessions AuthSession[]
  auditEvents  AuditEvent[]
  outboxEvents OutboxEvent[]

  @@index([status])
  @@map("organizations")
}

model Facility {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  code           String         @db.VarChar(64)
  name           String         @db.VarChar(160)
  timezone       String         @default("Asia/Shanghai") @db.VarChar(64)
  status         FacilityStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataScopes               DataScope[]
  authSessions             AuthSession[]
  auditEvents              AuditEvent[]
  buildings                Building[]
  floors                   Floor[]
  zones                    Zone[]
  rooms                    Room[]
  beds                     Bed[]
  careLevels               CareLevel[]
  elders                   Elder[]
  admissions               AdmissionRecord[]
  elderStays               ElderStay[]
  familyRelationships      FamilyRelationship[]
  emergencyContacts        EmergencyContact[]
  accessibilityProfiles    AccessibilityProfile[]
  communicationPreferences CommunicationPreference[]
  personalBaselines        PersonalBaseline[]
  consentRecords           ConsentRecord[]
  sharingPreferences       SharingPreference[]
  staffProfiles            StaffProfile[]
  teams                    Team[]
  teamMemberships          TeamMembership[]
  shifts                   Shift[]
  shiftAssignments         ShiftAssignment[]
  shiftAssignmentScopes    ShiftAssignmentScope[]
  elderCareAssignments     ElderCareAssignment[]
  elderTimelineEntries     ElderTimelineEntry[]
  outboxEvents             OutboxEvent[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("facilities")
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  loginName           String     @map("login_name") @db.VarChar(96)
  normalizedLoginName String     @unique @map("normalized_login_name") @db.VarChar(96)
  displayName         String     @map("display_name") @db.VarChar(128)
  status              UserStatus @default(ACTIVE)
  sessionVersion      Int        @default(1) @map("session_version")
  accessVersion       Int        @default(1) @map("access_version")
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordCredential          PasswordCredential?
  userRoles                   UserRole[]           @relation("AssignedUser")
  createdAssignments          UserRole[]           @relation("UserRoleCreatedBy")
  revokedAssignments          UserRole[]           @relation("UserRoleRevokedBy")
  sessions                    AuthSession[]
  auditEvents                 AuditEvent[]
  elderProfile                Elder?               @relation("ElderPortalUser")
  staffProfiles               StaffProfile[]       @relation("StaffProfileUser")
  familyRelationships         FamilyRelationship[] @relation("FamilyRelationshipUser")
  verifiedFamilyRelationships FamilyRelationship[] @relation("FamilyRelationshipVerifier")
  baselineSources             PersonalBaseline[]   @relation("PersonalBaselineSourceUser")
  recordedConsents            ConsentRecord[]      @relation("ConsentRecordedByUser")
  timelineEntries             ElderTimelineEntry[] @relation("TimelineActorUser")

  @@index([status])
  @@map("users")
}

model PasswordCredential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(512)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]
  userAssignments UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(128)
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  activeFrom      DateTime  @default(now()) @map("active_from") @db.Timestamptz(3)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation("AssignedUser", fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("UserRoleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy    User?        @relation("UserRoleRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  dataScopes   DataScope[]

  @@unique([id, organizationId])
  @@index([userId, organizationId, revokedAt, expiresAt])
  @@index([organizationId, roleId, revokedAt])
  @@map("user_roles")
}

model DataScope {
  id             String        @id @default(uuid()) @db.Uuid
  userRoleId     String        @map("user_role_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  kind           DataScopeKind
  scopeKey       String        @map("scope_key") @db.VarChar(192)
  facilityId     String?       @map("facility_id") @db.Uuid
  resourceType   String?       @map("resource_type") @db.VarChar(64)
  resourceId     String?       @map("resource_id") @db.VarChar(128)
  validFrom      DateTime      @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil     DateTime?     @map("valid_until") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  userRole UserRole  @relation(fields: [userRoleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([userRoleId, scopeKey])
  @@unique([id, organizationId, facilityId])
  @@index([organizationId, kind, facilityId])
  @@index([resourceType, resourceId])
  @@map("data_scopes")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  facilityId        String?   @map("facility_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash     String    @map("csrf_token_hash") @db.Char(64)
  sessionVersion    Int       @map("session_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(96)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility     Facility?    @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([userId, revokedAt, absoluteExpiresAt])
  @@index([organizationId, revokedAt, idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  facilityId     String?        @map("facility_id") @db.Uuid
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  action         String         @db.VarChar(128)
  outcome        AuditOutcome
  resourceType   String?        @map("resource_type") @db.VarChar(64)
  resourceId     String?        @map("resource_id") @db.VarChar(128)
  reasonCode     String?        @map("reason_code") @db.VarChar(96)
  correlationId  String         @map("correlation_id") @db.VarChar(128)
  safeMetadata   Json           @default("{}") @map("safe_metadata")
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility     Facility?    @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([correlationId])
  @@map("audit_events")
}

model Building {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  facilityId     String                  @map("facility_id") @db.Uuid
  code           String                  @db.VarChar(64)
  name           String                  @db.VarChar(160)
  status         FacilityStructureStatus @default(ACTIVE)
  sortOrder      Int                     @default(0) @map("sort_order")
  version        Int                     @default(1)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  facility Facility @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  floors   Floor[]

  @@unique([facilityId, code])
  @@unique([id, organizationId, facilityId])
  @@index([organizationId, facilityId, status, sortOrder])
  @@map("buildings")
}

model Floor {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  facilityId     String                  @map("facility_id") @db.Uuid
  buildingId     String                  @map("building_id") @db.Uuid
  code           String                  @db.VarChar(64)
  name           String                  @db.VarChar(160)
  levelNumber    Int                     @map("level_number")
  status         FacilityStructureStatus @default(ACTIVE)
  sortOrder      Int                     @default(0) @map("sort_order")
  version        Int                     @default(1)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  facility              Facility               @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  building              Building               @relation(fields: [buildingId, organizationId, facilityId], references: [id, organizationId, facilityId], onDelete: Restrict)
  zones                 Zone[]
  rooms                 Room[]
  shiftAssignmentScopes ShiftAssignmentScope[]

  @@unique([buildingId, code])
  @@unique([buildingId, levelNumber])
  @@unique([id, organizationId, facilityId])
  @@index([organizationId, facilityId, status, sortOrder])
  @@map("floors")
}

model Zone {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  facilityId     String                  @map("facility_id") @db.Uuid
  floorId        String                  @map("floor_id") @db.Uuid
  code           String                  @db.VarChar(64)
  name           String                  @db.VarChar(160)
  status         FacilityStructureStatus @default(ACTIVE)
  sortOrder      Int                     @default(0) @map("sort_order")
  version        Int                     @default(1)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  facility              Facility               @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  floor                 Floor                  @relation(fields: [floorId, organizationId, facilityId], references: [id, organizationId, facilityId], onDelete: Restrict)
  rooms                 Room[]
  shiftAssignmentScopes ShiftAssignmentScope[]

  @@unique([floorId, code])
  @@unique([id, organizationId, facilityId, floorId])
  @@index([organizationId, facilityId, status, sortOrder])
  @@map("zones")
}

model Room {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  facilityId     String                  @map("facility_id") @db.Uuid
  floorId        String                  @map("floor_id") @db.Uuid
  zoneId         String?                 @map("zone_id") @db.Uuid
  code           String                  @db.VarChar(64)
  name           String                  @db.VarChar(160)
  status         FacilityStructureStatus @default(ACTIVE)
  version        Int                     @default(1)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  facility Facility @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  floor    Floor    @relation(fields: [floorId, organizationId, facilityId], references: [id, organizationId, facilityId], onDelete: Restrict)
  zone     Zone?    @relation(fields: [zoneId, organizationId, facilityId, floorId], references: [id, organizationId, facilityId, floorId], onDelete: Restrict)
  beds     Bed[]

  @@unique([floorId, code])
  @@unique([id, organizationId, facilityId])
  @@index([organizationId, facilityId, zoneId, status])
  @@map("rooms")
}

model Bed {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  facilityId        String               @map("facility_id") @db.Uuid
  roomId            String               @map("room_id") @db.Uuid
  code              String               @db.VarChar(64)
  label             String               @db.VarChar(160)
  operationalStatus BedOperationalStatus @default(ACTIVE) @map("operational_status")
  version           Int                  @default(1)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  facility Facility    @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  room     Room        @relation(fields: [roomId, organizationId, facilityId], references: [id, organizationId, facilityId], onDelete: Restrict)
  stays    ElderStay[]

  @@unique([roomId, code])
  @@unique([id, organizationId, facilityId])
  @@index([organizationId, facilityId, operationalStatus])
  @@map("beds")
}

model CareLevel {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  facilityId     String          @map("facility_id") @db.Uuid
  code           String          @db.VarChar(64)
  name           String          @db.VarChar(160)
  rank           Int
  description    String?         @db.VarChar(1000)
  status         CareLevelStatus @default(ACTIVE)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  facility Facility @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  elders   Elder[]

  @@unique([facilityId, code])
  @@unique([facilityId, rank])
  @@unique([id, organizationId, facilityId])
  @@index([organizationId, facilityId, status])
  @@map("care_levels")
}

model Elder {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  facilityId         String            @map("facility_id") @db.Uuid
  portalUserId       String?           @unique @map("portal_user_id") @db.Uuid
  recordNumber       String            @map("record_number") @db.VarChar(64)
  displayName        String            @map("display_name") @db.VarChar(160)
  preferredName      String?           @map("preferred_name") @db.VarChar(80)
  birthDate          DateTime?         @map("birth_date") @db.Date
  currentCareLevelId String?           @map("current_care_level_id") @db.Uuid
  status             ElderRecordStatus @default(ACTIVE)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  facility                Facility                 @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  portalUser              User?                    @relation("ElderPortalUser", fields: [portalUserId], references: [id], onDelete: Restrict)
  currentCareLevel        CareLevel?               @relation(fields: [currentCareLevelId, organizationId, facilityId], references: [id, organizationId, facilityId], onDelete: Restrict)
  admissions              AdmissionRecord[]
  stays                   ElderStay[]
  familyRelationships     FamilyRelationship[]
  emergencyContacts       EmergencyContact[]
  accessibilityProfile    AccessibilityProfile?
  communicationPreference CommunicationPreference?
  personalBaselines       PersonalBaseline[]
  consentRecords          ConsentRecord[]
  careAssignments         ElderCareAssignment[]
  timelineEntries         ElderTimelineEntry[]

  @@unique([facilityId, recordNumber])
  @@unique([id, organizationId, facilityId])
  @@index([organizationId, facilityId, status])
  @@index([displayName])
  @@map("elders")
}

model AdmissionRecord {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  facilityId          String          @map("facility_id") @db.Uuid
  elderId             String          @map("elder_id") @db.Uuid
  admissionNumber     String          @map("admission_number") @db.VarChar(64)
  status              AdmissionStatus @default(ADMITTED)
  admittedAt          DateTime        @map("admitted_at") @db.Timestamptz(3)
  dischargedAt        DateTime?       @map("discharged_at") @db.Timestamptz(3)
  admissionReasonCode String?         @map("admission_reason_code") @db.VarChar(64)
  dischargeReasonCode String?         @map("discharge_reason_code") @db.VarChar(64)
  version             Int             @default(1)
